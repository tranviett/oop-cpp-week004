#include <iostream>
using namespace std;
// Bai 3: Kiem tra so hoan hao
void bai3() {
    cout << "\n=== BAI 3: KIEM TRA SO HOAN HAO ===\n";
    int n;
    cout << "Nhap n: ";
    cin >> n;
    int tongUoc = 0;
    for (int i = 1; i < n; i++) {
        if (n % i == 0) {
            tongUoc += i;
        }
    }
    if (tongUoc == n && n > 0) {
        cout << n << " la so hoan hao." << endl;
    } else {
        cout << n << " khong phai la so hoan hao." << endl;
    }
}